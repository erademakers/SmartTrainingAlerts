<settings>
  <!-- Heart Rate zone settings -->
  <setting propertyKey="@Properties.hr_zone4_5_reset_enabled" title="Reset Z4/Z5 after recovery">
    <settingConfig type="boolean" />
  </setting>
  <setting propertyKey="@Properties.hr_zone4_5_reset_ref_zone_max" title="Recovery reference zone (or lower)">
    <settingConfig type="list">
      <listEntry value="1">Zone 1 or lower</listEntry>
      <listEntry value="2">Zone 2 or lower</listEntry>
      <listEntry value="3">Zone 3 or lower</listEntry>
    </settingConfig>
  </setting>
  <setting propertyKey="@Properties.hr_zone4_5_reset_min_ref_sec" title="Min recovery time (s)">
    <settingConfig type="numeric" />
  </setting>

  <setting propertyKey="@Properties.hr_zone1_max" title="Zone 1 max time (s)">
    <settingConfig type="numeric" />
  </setting>
  <setting propertyKey="@Properties.hr_zone1_alert" title="Zone 1 alerts on">
    <settingConfig type="boolean" />
  </setting>

  <setting propertyKey="@Properties.hr_zone2_max" title="Zone 2 max time (s)">
    <settingConfig type="numeric" />
  </setting>
  <setting propertyKey="@Properties.hr_zone2_alert" title="Zone 2 alerts on">
    <settingConfig type="boolean" />
  </setting>

  <setting propertyKey="@Properties.hr_zone3_max" title="Zone 3 max time (s)">
    <settingConfig type="numeric" />
  </setting>
  <setting propertyKey="@Properties.hr_zone3_alert" title="Zone 3 alerts on">
    <settingConfig type="boolean" />
  </setting>

  <setting propertyKey="@Properties.hr_zone4_max" title="Zone 4 max time (s)">
    <settingConfig type="numeric" />
  </setting>
  <setting propertyKey="@Properties.hr_zone4_alert" title="Zone 4 alerts on">
    <settingConfig type="boolean" />
  </setting>

  <setting propertyKey="@Properties.hr_zone5_max" title="Zone 5 max time (s)">
    <settingConfig type="numeric" />
  </setting>
  <setting propertyKey="@Properties.hr_zone5_alert" title="Zone 5 alerts on">
    <settingConfig type="boolean" />
  </setting>
</settings>
